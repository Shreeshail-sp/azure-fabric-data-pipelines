{
	"name": "PL_GitHub_Full_Load_Food",
	"properties": {
		"activities": [
			{
				"name": "Web_Get_GitHub_Files",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/Shreeshail-sp/azure-fabric-data-pipelines/contents/data?ref=main"
				}
			},
			{
				"name": "Iterate_Through_All_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Web_Get_GitHub_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('Web_Get_GitHub_Files').output.Response)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_GitHub_Data_Folder",
									"type": "DatasetReference",
									"parameters": {
										"pFilePath": {
											"value": "@item().path",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Food",
									"type": "DatasetReference",
									"parameters": {
										"pFileName": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Append_On_Success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "vMetadataRows",
								"value": {
									"value": "@concat(\n    pipeline().RunId,\n    ',',\n    item().name,\n    ',',\n    item().path,\n    ',Success,',\n    activity('Copy data1').output.rowsCopied,\n    ',',\n    activity('Copy data1').output.dataRead,\n    ',',\n    activity('Copy data1').output.dataWritten,\n    ',,',\n    utcnow()\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append_On_Failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "vMetadataRows",
								"value": {
									"value": "@concat(\n    pipeline().RunId,\n    ',',\n    item().name,\n    ',',\n    item().path,\n    ',Failed,',\n    '0,',\n    '0,',\n    '0,',\n    activity('Copy data1').error.message,\n    ',',\n    utcnow()\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set_Metadata_CSV",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Iterate_Through_All_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vMetadataCsv",
					"value": {
						"value": "@join(variables('vMetadataRows'), decodeUriComponent('%0A'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Read_Existing_Metadata",
				"description": "Try to GET the existing metadata CSV from blob. If the file exists, output.Response contains CSV text. If not (404), the activity fails — which is expected and handled.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Metadata_CSV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"x-ms-version": "2021-08-06"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pLogContainer, '/', pipeline().parameters.pMetadataFilePath)",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			},
			{
				"name": "Set_Existing_Content",
				"description": "File exists — capture the existing CSV content from the GET response.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Read_Existing_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vExistingContent",
					"value": {
						"value": "@activity('Read_Existing_Metadata').output.Response",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Existing_Empty",
				"description": "File does NOT exist (GET returned 404) — set existing content to empty string so we know to add the header row.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Read_Existing_Metadata",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vExistingContent",
					"value": {
						"value": "@string('')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Write_Metadata_To_Blob",
				"description": "Write the combined metadata (existing + new rows) to a SINGLE persistent CSV file. If the file is new, the header row is included. If the file existed, new rows are appended below existing data.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Existing_Content",
						"dependencyConditions": [
							"Succeeded",
							"Skipped"
						]
					},
					{
						"activity": "Set_Existing_Empty",
						"dependencyConditions": [
							"Succeeded",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-blob-type": "BlockBlob",
						"x-ms-version": "2021-08-06",
						"Content-Type": "text/csv"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pLogContainer, '/', pipeline().parameters.pMetadataFilePath)",
						"type": "Expression"
					},
					"body": {
						"value": "@if(\n    equals(variables('vExistingContent'), ''),\n    concat('RunId,FileName,FilePath,Status,RowsCopied,DataRead,DataWritten,ErrorMessage,Timestamp', decodeUriComponent('%0A'), variables('vMetadataCsv')),\n    concat(variables('vExistingContent'), decodeUriComponent('%0A'), variables('vMetadataCsv'))\n)",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			}
		],
		"parameters": {
			"pStorageAccountName": {
				"type": "string",
				"defaultValue": "practicefullload"
			},
			"pLogContainer": {
				"type": "string",
				"defaultValue": "datastorage"
			},
			"pMetadataFilePath": {
				"type": "string",
				"defaultValue": "logs/Meta_Data/pipeline_metadata.csv"
			}
		},
		"variables": {
			"vMetadataRows": {
				"type": "Array"
			},
			"vRunId": {
				"type": "String",
				"defaultValue": "@pipeline().RunId"
			},
			"vMetadataCsv": {
				"type": "String"
			},
			"vExistingContent": {
				"type": "String"
			}
		},
		"annotations": []
	}
}