{
	"name": "PL_GitHub_Full_Load_Food",
	"properties": {
		"activities": [
			{
				"name": "Web_Get_GitHub_Files",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/Shreeshail-sp/azure-fabric-data-pipelines/contents/data?ref=main"
				}
			},
			{
				"name": "Iterate_Through_All_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Web_Get_GitHub_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('Web_Get_GitHub_Files').output.Response)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_GitHub_Data_Folder",
									"type": "DatasetReference",
									"parameters": {
										"pFilePath": {
											"value": "@item().path",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Food",
									"type": "DatasetReference",
									"parameters": {
										"pFileName": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "vMetadataRows",
								"value": {
									"value": "@json(concat(\n'{',\n'\"runId\":\"', pipeline().RunId, '\",',\n'\"fileName\":\"', item().name, '\",',\n'\"filePath\":\"', item().path, '\",',\n'\"status\":\"Succeeded\",',\n'\"errorMessage\":\"\"',\n'}'\n))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append variable1_copy1",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "vMetadataRows",
								"value": {
									"value": "@json(concat(\n'{',\n'\"runId\":\"', pipeline().RunId, '\",',\n'\"fileName\":\"', item().name, '\",',\n'\"filePath\":\"', item().path, '\",',\n'\"status\":\"Failed\",',\n'\"errorMessage\":\"Copy failed\"',\n'}'\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"vMetadataRows": {
				"type": "Array"
			},
			"vRunId": {
				"type": "String",
				"defaultValue": "@pipeline().RunId"
			},
			"vMetadataCsv": {
				"type": "String"
			}
		},
		"annotations": []
	}
}