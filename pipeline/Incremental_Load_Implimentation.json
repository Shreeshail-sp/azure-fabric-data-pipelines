{
	"name": "Incremental_Load_Implimentation",
	"properties": {
		"activities": [
			{
				"name": "Incremental_Load_Web_Activity",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/Shreeshail-sp/azure-fabric-data-pipelines/contents/data?ref=main"
				}
			},
			{
				"name": "Lookup_Watermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Incremental_Load_Web_Activity",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Github_Watermark",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterate_Through_All_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('Incremental_Load_Web_Activity').output.Response)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set_Current_File",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vCurrentFileName",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Current_File_SHA",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Current_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vCurrentSHA",
								"value": {
									"value": "@item().sha",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Filter_Watermark_Current_File",
							"type": "Filter",
							"dependsOn": [
								{
									"activity": "Set_Current_File_SHA",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Lookup_Watermark').output.value",
									"type": "Expression"
								},
								"condition": {
									"value": "@equals(item().FileName, variables('vCurrentFileName'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "If_File_Changed",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Filter_Watermark_Current_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@if(equals(activity('Filter_Watermark_Current_File').output.FilteredItemsCount, 0), true, not(equals(variables('vCurrentSHA'), activity('Filter_Watermark_Current_File').output.value[0].SHA)))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Append_Metadata_Skipped",
										"type": "AppendVariable",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vMetadataRows",
											"value": {
												"value": "@concat(pipeline().RunId, ',', item().name, ',', item().path, ',Skipped,0,0,0,,', utcnow())",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Append_Watermark_Unchanged",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "Append_Metadata_Skipped",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vUpdatedWatermarkRows",
											"value": {
												"value": "@concat(item().name, ',', item().sha)",
												"type": "Expression"
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy_Changed_File",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "RestSource",
												"httpRequestTimeout": "00:01:40",
												"requestInterval": "00.00:00:00.010",
												"requestMethod": "GET",
												"paginationRules": {
													"supportRFC5988": "true"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_GitHub_Data_Folder",
												"type": "DatasetReference",
												"parameters": {
													"pFilePath": {
														"value": "@item().path",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_Food",
												"type": "DatasetReference",
												"parameters": {
													"pFileName": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Append_Metadata_Copied",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "Copy_Changed_File",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vMetadataRows",
											"value": {
												"value": "@concat(pipeline().RunId, ',', item().name, ',', item().path, ',Copied,', string(activity('Copy_Changed_File').output.rowsCopied), ',', string(activity('Copy_Changed_File').output.dataRead), ',', string(activity('Copy_Changed_File').output.dataWritten), ',,', utcnow())",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Append_Watermark_Entry",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "Append_Metadata_Copied",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vUpdatedWatermarkRows",
											"value": {
												"value": "@concat(item().name, ',', item().sha)",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Set_Metadata_CSV",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Iterate_Through_All_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vMetadataCsv",
					"value": {
						"value": "@join(variables('vMetadataRows'), decodeUriComponent('%0A'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Watermark_CSV",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Metadata_CSV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vWatermarkCsv",
					"value": {
						"value": "@join(variables('vUpdatedWatermarkRows'), decodeUriComponent('%0A'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Write_Metadata_Log_To_Blob",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Watermark_CSV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-blob-type": "BlockBlob",
						"x-ms-version": "2021-08-06",
						"Content-Type": "text/csv"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pLogContainer, '/logs/', formatDateTime(utcnow(), 'yyyy-MM-dd'), '/', pipeline().RunId, '.csv')",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('RunId,FileName,FilePath,Status,RowsCopied,DataRead,DataWritten,ErrorMessage,Timestamp', decodeUriComponent('%0A'), variables('vMetadataCsv'))",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			},
			{
				"name": "Update_Watermark_File",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Write_Metadata_Log_To_Blob",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-blob-type": "BlockBlob",
						"x-ms-version": "2021-08-06",
						"Content-Type": "text/csv"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pWatermarkContainer, '/watermark/github_watermark.csv')",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('FileName,SHA', decodeUriComponent('%0A'), variables('vWatermarkCsv'))",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			}
		],
		"parameters": {
			"pStorageAccountName": {
				"type": "string",
				"defaultValue": "practicefullload"
			},
			"pLogContainer": {
				"type": "string",
				"defaultValue": "datastorage"
			},
			"pWatermarkContainer": {
				"type": "string",
				"defaultValue": "datastorage"
			}
		},
		"variables": {
			"vCurrentFileName": {
				"type": "String"
			},
			"vCurrentSHA": {
				"type": "String"
			},
			"vMetadataRows": {
				"type": "Array"
			},
			"vMetadataCsv": {
				"type": "String"
			},
			"vUpdatedWatermarkRows": {
				"type": "Array"
			},
			"vWatermarkCsv": {
				"type": "String"
			}
		},
		"annotations": []
	}
}