{
	"name": "Incremental_Load_Implimentation",
	"properties": {
		"activities": [
			{
				"name": "Incremental_Load_Web_Activity",
				"description": "Fetch current list of files + their SHA hashes from the GitHub repo.",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/Shreeshail-sp/azure-fabric-data-pipelines/contents/data?ref=main"
				}
			},
			{
				"name": "Lookup_Metadata",
				"description": "Read the existing metadata CSV (written by Full Load). Used to extract last known SHA per file for change detection. File is guaranteed to exist since Full Load runs first.",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Incremental_Load_Web_Activity",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_ADLS_Metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterate_Through_All_Files",
				"description": "Loop over every file returned by GitHub API. For each, check SHA history to decide copy or skip.",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('Incremental_Load_Web_Activity').output.Response)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set_Current_File",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vCurrentFileName",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Current_File_SHA",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Current_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vCurrentSHA",
								"value": {
									"value": "@item().sha",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Filter_Metadata_Current_File",
							"description": "Filter all metadata history rows for the current file name. May return multiple rows (one per run). We'll use the LAST entry's SHA as the watermark.",
							"type": "Filter",
							"dependsOn": [
								{
									"activity": "Set_Current_File_SHA",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Lookup_Metadata').output.value",
									"type": "Expression"
								},
								"condition": {
									"value": "@equals(item().FileName, variables('vCurrentFileName'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "If_File_Changed",
							"description": "Compare GitHub SHA with the LAST entry for this file in metadata. If no history entry for the file (new file added to repo after full load) → copy it. If SHA differs → copy. If SHA matches → skip.",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Filter_Metadata_Current_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@if(\n    equals(activity('Filter_Metadata_Current_File').output.FilteredItemsCount, 0),\n    true,\n    not(equals(\n        variables('vCurrentSHA'),\n        last(activity('Filter_Metadata_Current_File').output.value).SHA\n    ))\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Append_Metadata_Skipped",
										"type": "AppendVariable",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vMetadataRows",
											"value": {
												"value": "@concat(pipeline().RunId, ',', item().name, ',', item().path, ',', item().sha, ',Skipped,0,0,0,,', utcnow())",
												"type": "Expression"
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy_Changed_File",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "RestSource",
												"httpRequestTimeout": "00:01:40",
												"requestInterval": "00.00:00:00.010",
												"requestMethod": "GET",
												"paginationRules": {
													"supportRFC5988": "true"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_GitHub_Data_Folder",
												"type": "DatasetReference",
												"parameters": {
													"pFilePath": {
														"value": "@item().path",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_Food",
												"type": "DatasetReference",
												"parameters": {
													"pFileName": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Append_Metadata_Copied",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "Copy_Changed_File",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "vMetadataRows",
											"value": {
												"value": "@concat(pipeline().RunId, ',', item().name, ',', item().path, ',', item().sha, ',Copied,', string(activity('Copy_Changed_File').output.rowsCopied), ',', string(activity('Copy_Changed_File').output.dataRead), ',', string(activity('Copy_Changed_File').output.dataWritten), ',,', utcnow())",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Set_Metadata_CSV",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Iterate_Through_All_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vMetadataCsv",
					"value": {
						"value": "@join(variables('vMetadataRows'), decodeUriComponent('%0A'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Read_Existing_Metadata",
				"description": "GET the metadata CSV as raw text so we can append new rows to it. File is guaranteed to exist (Full Load created it).",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Metadata_CSV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"x-ms-version": "2021-08-06"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pLogContainer, '/', pipeline().parameters.pMetadataFilePath)",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			},
			{
				"name": "Write_Metadata_To_Blob",
				"description": "Append new incremental run rows to the existing metadata CSV. No header needed — file already has it from Full Load.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Read_Existing_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-blob-type": "BlockBlob",
						"x-ms-version": "2021-08-06",
						"Content-Type": "text/csv"
					},
					"url": {
						"value": "@concat('https://', pipeline().parameters.pStorageAccountName, '.blob.core.windows.net/', pipeline().parameters.pLogContainer, '/', pipeline().parameters.pMetadataFilePath)",
						"type": "Expression"
					},
					"body": {
						"value": "@concat(activity('Read_Existing_Metadata').output.Response, decodeUriComponent('%0A'), variables('vMetadataCsv'))",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			}
		],
		"parameters": {
			"pStorageAccountName": {
				"type": "string",
				"defaultValue": "practicefullload"
			},
			"pLogContainer": {
				"type": "string",
				"defaultValue": "datastorage"
			},
			"pMetadataFilePath": {
				"type": "string",
				"defaultValue": "logs/Meta_Data/pipeline_metadata.csv"
			}
		},
		"variables": {
			"vCurrentFileName": {
				"type": "String"
			},
			"vCurrentSHA": {
				"type": "String"
			},
			"vMetadataRows": {
				"type": "Array"
			},
			"vMetadataCsv": {
				"type": "String"
			}
		},
		"annotations": []
	}
}